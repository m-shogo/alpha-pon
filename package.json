{
  "name": "alpha-pon",
  "version": "0.1.0",
  "description": "長期投資向け調査候補・買い場候補自動発見アプリ",
  "type": "module",
  "scripts": {
    "daily": "node --env-file=.env --import tsx/esm src/daily.ts",
    "daily:mock": "node --env-file=.env --import tsx/esm src/daily.ts --mock",
    "scan:world": "node --env-file=.env --import tsx/esm src/scan-world-events.ts",
    "review:analogies": "node --env-file=.env --import tsx/esm src/review-analogies.ts",
    "review:analogies:write": "node --env-file=.env --import tsx/esm src/review-analogies.ts --write",
    "review:weekly": "node --import tsx/esm src/periodic-review.ts --weekly",
    "review:monthly": "node --import tsx/esm src/periodic-review.ts --monthly",
    "diagnose:rules": "node --import tsx/esm src/rule-diagnostics.ts",
    "memory:companies": "node --import tsx/esm src/update-company-memory.ts",
    "learn:primary": "node --import tsx/esm src/primary-disclosure-learning.ts",
    "learn:primary:category": "node --import tsx/esm src/primary-disclosure-category-learning.ts",
    "health:sources": "node --import tsx/esm src/source-health.ts",
    "maintain:data": "node --import tsx/esm src/maintain-data.ts",
    "maintain:data:write": "node --import tsx/esm src/maintain-data.ts --write",
    "pipeline:message": "node --env-file=.env --import tsx/esm src/pipeline-message.ts",
    "lessons": "node --import tsx/esm src/lessons.ts",
    "scan:edinet": "node --env-file=.env --import tsx/esm src/scan-edinet.ts",
    "scan:edinet:annual": "node --env-file=.env --import tsx/esm src/scan-edinet-annual.ts",
    "setup:line": "node --env-file=.env --import tsx/esm src/setup-line.ts",
    "backtest": "node --env-file=.env --import tsx/esm src/backtest.ts",
    "learn": "node --import tsx/esm src/learn.ts",
    "register:company:preview": "node --import tsx/esm src/register-company-context.ts --sample=sanrio",
    "register:company:sanrio": "node --import tsx/esm src/register-company-context.ts --sample=sanrio --write",
    "ui:data": "node --import tsx/esm src/report-ui-data.ts",
    "sync:ipo": "node --env-file=.env --import tsx/esm src/sync-ipo.ts --dry-run",
    "sync:ipo:dry": "node --env-file=.env --import tsx/esm src/sync-ipo.ts --dry-run",
    "sync:tdnet": "node --env-file=.env --import tsx/esm src/sync-tdnet.ts --dry-run",
    "sync:tdnet:dry": "node --env-file=.env --import tsx/esm src/sync-tdnet.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx/esm tests/score.test.ts && node --import tsx/esm tests/validation.test.ts && node --import tsx/esm tests/analysis.test.ts && node --import tsx/esm tests/expert-ensemble.test.ts",
    "check": "pnpm typecheck && pnpm typecheck:tests && pnpm test",
    "ci:smoke": "NOTIFY_MODE=off pnpm daily:mock && pnpm learn:primary && pnpm health:sources && test -f reports/latest.md && test -f reports/primary_disclosure_learning_latest.md && test -f reports/primary_disclosure_category_learning_latest.md && test -f reports/source_health_latest.md",
    "launchd:install": "mkdir -p logs && cp launchd/com.alpha-pon.daily.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.alpha-pon.daily.plist && echo 'launchd登録完了'",
    "launchd:uninstall": "launchctl unload ~/Library/LaunchAgents/com.alpha-pon.daily.plist && rm ~/Library/LaunchAgents/com.alpha-pon.daily.plist && echo 'launchd登録解除完了'",
    "launchd:status": "launchctl list | grep alpha-pon || echo '未登録'",
    "scan:universe": "node --env-file=.env --import tsx/esm src/scan-stock-universe.ts",
    "candidate:hypothesis": "node --import tsx/esm src/stock-candidate-hypothesis.ts",
    "review:hypotheses": "node --env-file=.env --import tsx/esm src/review-hypothesis-outcomes.ts",
    "daily:full": "pnpm scan:world && pnpm daily && pnpm scan:universe && pnpm candidate:hypothesis && pnpm review:hypotheses && pnpm ui:data",
    "web:dev": "pnpm --filter @alpha-pon/web dev",
    "web:build": "pnpm --filter @alpha-pon/web build",
    "web:start": "pnpm --filter @alpha-pon/web start",
    "web:typecheck": "pnpm --filter @alpha-pon/web typecheck",
    "web:prepare": "pnpm ui:data && pnpm web:build"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
