{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/outcome-learning-shadow-evaluation.schema.json",
  "title": "Alpha Pon Outcome Learning Shadow Evaluation v1",
  "description": "Append-only shadow evaluation of a human-approved learning proposal. Criteria are frozen from the proposal and evidence is validated, but no rule/code/Gate/trading mutation is authorized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evaluationId",
    "evaluatedAt",
    "evidenceCutoff",
    "decisionId",
    "decisionContentHash",
    "proposalId",
    "proposalContentHash",
    "evaluationStage",
    "evaluationMethod",
    "successCriteriaAssessments",
    "failureCriteriaAssessments",
    "minimumEvidenceAssessments",
    "falsificationAssessments",
    "evidenceRefs",
    "verdict",
    "humanReviewRequired",
    "automaticApplyAuthorized",
    "ruleMutationAuthorized",
    "edgeGateMutationAuthorized",
    "codeMutationAuthorized",
    "automaticTradingAuthorized",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evaluationId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "evidenceCutoff": { "type": "string", "format": "date-time" },
    "decisionId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "decisionContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposalId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "proposalContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evaluationStage": { "type": "string", "enum": ["interim", "final"] },
    "evaluationMethod": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "successCriteriaAssessments": { "$ref": "#/$defs/assessmentList" },
    "failureCriteriaAssessments": { "$ref": "#/$defs/assessmentList" },
    "minimumEvidenceAssessments": { "$ref": "#/$defs/assessmentList" },
    "falsificationAssessments": { "$ref": "#/$defs/assessmentList" },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "verdict": { "type": "string", "enum": ["supports_change", "rejects_change", "inconclusive"] },
    "supersedesEvaluationId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "humanReviewRequired": { "const": true },
    "automaticApplyAuthorized": { "const": false },
    "ruleMutationAuthorized": { "const": false },
    "edgeGateMutationAuthorized": { "const": false },
    "codeMutationAuthorized": { "const": false },
    "automaticTradingAuthorized": { "const": false },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "assessmentList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "assessment", "evidenceRefs"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "assessment": { "type": "string", "enum": ["met", "not_met", "inconclusive"] },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    }
  }
}
