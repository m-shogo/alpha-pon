{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-pon.local/schemas/stock-pro-council-v2.schema.json",
  "title": "Stock Pro Council v2 Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "updatedAt",
    "purpose",
    "activationGate",
    "protocol",
    "personas",
    "existingAgentMigration",
    "nextImplementation"
  ],
  "properties": {
    "version": { "const": 2 },
    "status": { "const": "catalog_only" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "purpose": { "type": "string", "minLength": 20 },
    "activationGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaValidated",
        "verdictValidatorImplemented",
        "dissentLedgerImplemented",
        "deterministicReplayImplemented",
        "calibrationStoreImplemented",
        "recommendationIntegrationImplemented"
      ],
      "properties": {
        "schemaValidated": { "type": "boolean" },
        "verdictValidatorImplemented": { "type": "boolean" },
        "dissentLedgerImplemented": { "type": "boolean" },
        "deterministicReplayImplemented": { "type": "boolean" },
        "calibrationStoreImplemented": { "type": "boolean" },
        "recommendationIntegrationImplemented": { "type": "boolean" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voting",
        "majorityCanOverrideHardVeto",
        "abstentionIsFirstClass",
        "preserveDissent",
        "confidenceRequiresCalibration",
        "separateStockVerdictAndSuitability",
        "automaticTradingAuthorized"
      ],
      "properties": {
        "voting": { "const": "jurisdictional_veto" },
        "majorityCanOverrideHardVeto": { "const": false },
        "abstentionIsFirstClass": { "const": true },
        "preserveDissent": { "const": true },
        "confidenceRequiresCalibration": { "const": true },
        "separateStockVerdictAndSuitability": { "const": true },
        "automaticTradingAuthorized": { "const": false }
      }
    },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/persona" }
    },
    "existingAgentMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "policy"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "complete"]
        },
        "policy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    },
    "nextImplementation": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 5 }
    }
  },
  "$defs": {
    "nonEmptyUniqueStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "jurisdiction",
        "mission",
        "requiredInputs",
        "abstainWhen",
        "hardVetoes",
        "calibration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "label": { "type": "string", "minLength": 2 },
        "jurisdiction": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
        "mission": { "type": "string", "minLength": 10 },
        "requiredInputs": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
        "abstainWhen": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "hardVetoes": { "$ref": "#/$defs/nonEmptyUniqueStringArray" },
        "calibration": { "$ref": "#/$defs/nonEmptyUniqueStringArray" }
      }
    }
  }
}
