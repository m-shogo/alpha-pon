{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/outcome-learning-adoption-decision.schema.json",
  "title": "Alpha Pon Outcome Learning Adoption Decision v1",
  "description": "Append-only final human decision after a validated final Shadow Evaluation. Approval authorizes only preparation of a governed change artifact; no rule/code/Gate/trading mutation is automatic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adoptionDecisionId",
    "decidedAt",
    "shadowEvaluationId",
    "shadowEvaluationContentHash",
    "proposalId",
    "proposalContentHash",
    "reviewerRef",
    "decision",
    "decisionRationale",
    "conditions",
    "evidenceRefs",
    "shadowEvaluationReviewed",
    "rollbackPlanAcknowledged",
    "humanDecisionConfirmed",
    "governedChangePreparationAuthorized",
    "automaticApplyAuthorized",
    "ruleMutationAuthorized",
    "edgeGateMutationAuthorized",
    "codeMutationAuthorized",
    "automaticTradingAuthorized",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "adoptionDecisionId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "decidedAt": { "type": "string", "format": "date-time" },
    "shadowEvaluationId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "shadowEvaluationContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposalId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "proposalContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewerRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "decision": { "type": "string", "enum": ["defer", "approve_change_preparation", "reject"] },
    "decisionRationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "conditions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "supersedesAdoptionDecisionId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "shadowEvaluationReviewed": { "const": true },
    "rollbackPlanAcknowledged": { "const": true },
    "humanDecisionConfirmed": { "const": true },
    "governedChangePreparationAuthorized": { "type": "boolean" },
    "automaticApplyAuthorized": { "const": false },
    "ruleMutationAuthorized": { "const": false },
    "edgeGateMutationAuthorized": { "const": false },
    "codeMutationAuthorized": { "const": false },
    "automaticTradingAuthorized": { "const": false },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
