{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/outcome-learning-change-preparation.schema.json",
  "title": "Alpha Pon Governed Change Preparation Manifest v1",
  "description": "Append-only pre-implementation manifest created only after final human adoption approval. It freezes scope and validation requirements but does not mutate code, rules, Gates, production or trading state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "createdAt",
    "preparedByRef",
    "preparedByKind",
    "adoptionDecisionId",
    "adoptionDecisionContentHash",
    "proposalId",
    "proposalContentHash",
    "preparationStage",
    "targetKind",
    "targetRef",
    "proposedChange",
    "rollbackPlan",
    "adoptionConditions",
    "plannedArtifacts",
    "validationRequirements",
    "explicitNonGoals",
    "implementationMode",
    "humanReviewRequired",
    "pullRequestPreparationAuthorized",
    "automaticApplyAuthorized",
    "workflowMutationAuthorized",
    "secretMutationAuthorized",
    "billingMutationAuthorized",
    "productionMutationAuthorized",
    "ruleMutationAuthorized",
    "edgeGateMutationAuthorized",
    "codeMutationAuthorized",
    "automaticTradingAuthorized",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "createdAt": { "type": "string", "format": "date-time" },
    "preparedByRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "preparedByKind": { "type": "string", "enum": ["human", "ai"] },
    "adoptionDecisionId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "adoptionDecisionContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "proposalId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "proposalContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preparationStage": { "type": "string", "enum": ["draft", "ready_for_pr"] },
    "targetKind": {
      "type": "string",
      "enum": ["research_rule", "edge_gate", "evidence_requirement", "calibration", "scoring", "backtest_method", "operational_guard"]
    },
    "targetRef": { "type": "string", "minLength": 1, "maxLength": 512 },
    "proposedChange": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "rollbackPlan": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "adoptionConditions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "plannedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "purpose"],
        "properties": {
          "kind": { "type": "string", "enum": ["code", "config", "schema", "test", "docs", "data_contract"] },
          "path": { "type": "string", "minLength": 1, "maxLength": 512 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "validationRequirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "explicitNonGoals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "supersedesManifestId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "implementationMode": { "const": "manual_pr_only" },
    "humanReviewRequired": { "const": true },
    "pullRequestPreparationAuthorized": { "const": true },
    "automaticApplyAuthorized": { "const": false },
    "workflowMutationAuthorized": { "const": false },
    "secretMutationAuthorized": { "const": false },
    "billingMutationAuthorized": { "const": false },
    "productionMutationAuthorized": { "const": false },
    "ruleMutationAuthorized": { "const": false },
    "edgeGateMutationAuthorized": { "const": false },
    "codeMutationAuthorized": { "const": false },
    "automaticTradingAuthorized": { "const": false },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
