{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/outcome-learning-decision.schema.json",
  "title": "Alpha Pon Outcome Learning Human Decision v1",
  "description": "Append-only human decision over a validated, human-review-ready learning proposal. Advancing authorizes only shadow evaluation; it never authorizes rule/code/Gate mutation or trading.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "decidedAt",
    "proposalId",
    "proposalContentHash",
    "reviewerRef",
    "decision",
    "decisionRationale",
    "conditions",
    "evidenceRefs",
    "proposalReviewed",
    "evaluationPlanAcknowledged",
    "rollbackPlanAcknowledged",
    "humanDecisionConfirmed",
    "shadowEvaluationAuthorized",
    "automaticApplyAuthorized",
    "ruleMutationAuthorized",
    "edgeGateMutationAuthorized",
    "codeMutationAuthorized",
    "automaticTradingAuthorized",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decisionId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "decidedAt": { "type": "string", "format": "date-time" },
    "proposalId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "proposalContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewerRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "decision": { "type": "string", "enum": ["defer", "advance_to_shadow", "reject"] },
    "decisionRationale": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "conditions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "supersedesDecisionId": { "type": "string", "minLength": 1, "maxLength": 180 },
    "proposalReviewed": { "const": true },
    "evaluationPlanAcknowledged": { "const": true },
    "rollbackPlanAcknowledged": { "const": true },
    "humanDecisionConfirmed": { "const": true },
    "shadowEvaluationAuthorized": { "type": "boolean" },
    "automaticApplyAuthorized": { "const": false },
    "ruleMutationAuthorized": { "const": false },
    "edgeGateMutationAuthorized": { "const": false },
    "codeMutationAuthorized": { "const": false },
    "automaticTradingAuthorized": { "const": false },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
