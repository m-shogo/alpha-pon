{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-pon.local/schemas/security-master-relationship-record.schema.json",
  "title": "Alpha Pon Security Master Relationship Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "relationshipId",
    "relationshipType",
    "fromEntityId",
    "toEntityId",
    "validFrom",
    "confidence",
    "sourceRefs",
    "observedAt",
    "retrievedAt",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordId": { "type": "string", "minLength": 3 },
    "relationshipId": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9:_-]+$"
    },
    "relationshipType": {
      "type": "string",
      "enum": [
        "issuer_of",
        "listed_on",
        "parent_of",
        "subsidiary_of",
        "owns_brand",
        "operates_facility",
        "has_segment",
        "produces_product",
        "official_account_of",
        "renamed_from",
        "ticker_changed_from",
        "merged_into",
        "spun_off_from"
      ]
    },
    "fromEntityId": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9:_-]+$"
    },
    "toEntityId": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9:_-]+$"
    },
    "validFrom": { "type": "string", "format": "date" },
    "validTo": { "type": "string", "format": "date" },
    "ownershipPct": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence": {
      "type": "string",
      "enum": ["verified", "probable", "unresolved"]
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "supersedesRecordId": { "type": "string", "minLength": 3 },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
