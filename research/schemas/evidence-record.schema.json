{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-pon.local/schemas/evidence-record.schema.json",
  "title": "Alpha Pon Bitemporal Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "evidenceId",
    "entityIds",
    "sourceId",
    "sourceType",
    "sourceLocator",
    "sourceContentHash",
    "eventAtStatus",
    "publishedAt",
    "observedAt",
    "retrievedAt",
    "effectiveFrom",
    "firstExecutableAt",
    "evidenceTier",
    "status",
    "license",
    "storagePolicy",
    "title",
    "summary",
    "retrievalRunId",
    "parserVersion",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordId": { "type": "string", "minLength": 3 },
    "evidenceId": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9:_-]+$"
    },
    "entityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9:_-]+$"
      }
    },
    "sourceId": { "type": "string", "minLength": 2 },
    "sourceType": {
      "type": "string",
      "enum": [
        "statutory_filing",
        "exchange_disclosure",
        "company_ir",
        "government",
        "regulator",
        "court",
        "official_transcript",
        "reliable_news",
        "research_paper",
        "patent",
        "standard",
        "licensed_alternative",
        "discovery_only"
      ]
    },
    "sourceLocator": { "type": "string", "minLength": 3 },
    "documentId": { "type": "string", "minLength": 1 },
    "sourceContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "eventAtStatus": {
      "type": "string",
      "enum": ["known", "unknown", "not_applicable"]
    },
    "eventAt": { "type": "string", "format": "date-time" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "observedAt": { "type": "string", "format": "date-time" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "effectiveFrom": { "type": "string", "format": "date-time" },
    "effectiveTo": { "type": "string", "format": "date-time" },
    "firstExecutableAt": { "type": "string", "format": "date-time" },
    "evidenceTier": {
      "type": "string",
      "enum": [
        "primary_authoritative",
        "primary_company",
        "secondary_reliable",
        "discovery_only"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["active", "corrected", "retracted", "withdrawn", "expired"]
    },
    "license": {
      "type": "string",
      "enum": ["redistributable", "metadata_only", "local_only", "unknown"]
    },
    "storagePolicy": {
      "type": "string",
      "enum": ["metadata_only", "hash_only", "local_only_content", "redistributable_content"]
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 3 },
    "retrievalRunId": { "type": "string", "minLength": 1 },
    "parserVersion": { "type": "string", "minLength": 1 },
    "supersedesRecordId": { "type": "string", "minLength": 3 },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
