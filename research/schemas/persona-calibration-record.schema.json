{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-pon.local/schemas/persona-calibration-record.schema.json",
  "title": "Stock Pro Council Persona Calibration Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "calibrationId",
    "personaId",
    "personaVersion",
    "jurisdiction",
    "metric",
    "segment",
    "periodFrom",
    "periodTo",
    "outcomeCutoff",
    "evaluatedAt",
    "sampleSize",
    "minimumSampleSize",
    "normalizedScore",
    "confidenceInterval",
    "status",
    "eligibleForConfidence",
    "previousWeightMultiplier",
    "recommendedWeightMultiplier",
    "maxWeightStep",
    "humanApprovalRequired",
    "automaticWeightApplicationAuthorized",
    "evidenceRefs",
    "modelVersion",
    "ruleVersion",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "calibrationId": { "type": "string", "minLength": 3 },
    "personaId": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "personaVersion": { "type": "string", "minLength": 1 },
    "jurisdiction": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9_]+$"
    },
    "metric": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9_]+$"
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector", "regime", "horizon"],
      "properties": {
        "sector": { "type": "string", "minLength": 1 },
        "regime": { "type": "string", "minLength": 1 },
        "horizon": { "type": "string", "minLength": 1 },
        "edgeId": { "type": "string", "minLength": 1 }
      }
    },
    "periodFrom": { "type": "string", "format": "date" },
    "periodTo": { "type": "string", "format": "date" },
    "outcomeCutoff": { "type": "string", "format": "date-time" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "sampleSize": { "type": "integer", "minimum": 0 },
    "minimumSampleSize": { "type": "integer", "minimum": 1 },
    "normalizedScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "number", "minimum": 0, "maximum": 1 },
        "high": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "status": {
      "type": "string",
      "enum": ["provisional", "eligible", "retired", "superseded"]
    },
    "eligibleForConfidence": { "type": "boolean" },
    "confidenceCap": { "type": "number", "minimum": 0, "maximum": 1 },
    "previousWeightMultiplier": { "type": "number", "minimum": 0.8, "maximum": 1.2 },
    "recommendedWeightMultiplier": { "type": "number", "minimum": 0.8, "maximum": 1.2 },
    "maxWeightStep": { "const": 0.05 },
    "humanApprovalRequired": { "const": true },
    "automaticWeightApplicationAuthorized": { "const": false },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "modelVersion": { "type": "string", "minLength": 1 },
    "ruleVersion": { "type": "string", "minLength": 1 },
    "supersedesCalibrationId": { "type": "string", "minLength": 3 },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
