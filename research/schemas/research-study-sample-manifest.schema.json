{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"alpha-pon/research/research-study-sample-manifest.schema.json","title":"Research Study Sample Manifest","description":"Immutable sample-selection child record for a Study.","type":"object","additionalProperties":false,"required":["schemaVersion","ontologyVersion","id","studyId","role","createdAt","selectionCutoff","selectionMethod","includedCaseIds","excludedCases"],"properties":{"schemaVersion":{"const":1},"ontologyVersion":{"const":"research-knowledge-v1"},"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"studyId":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"role":{"type":"string","enum":["exploratory","calibration","confirmatory","holdout","out_of_sample","revalidation"]},"createdAt":{"type":"string","format":"date-time"},"selectionCutoff":{"type":"string","format":"date-time"},"selectionMethod":{"type":"string","minLength":4,"maxLength":4000},"includedCaseIds":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128}},"excludedCases":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/excludedCase"}}},"$defs":{"excludedCase":{"type":"object","additionalProperties":false,"required":["caseId","reason"],"properties":{"caseId":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"reason":{"type":"string","minLength":4,"maxLength":1000}}}}}
