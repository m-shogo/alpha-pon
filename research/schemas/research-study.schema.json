{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"alpha-pon/research/research-study.schema.json","title":"Research Study","description":"Specific research design, distinct from Edge and Recommendation Outcome.","type":"object","additionalProperties":false,"required":["schemaVersion","ontologyVersion","id","title","mode","status","createdAt","purpose"],"properties":{"schemaVersion":{"const":1},"ontologyVersion":{"const":"research-knowledge-v1"},"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"title":{"type":"string","minLength":4,"maxLength":200},"mode":{"type":"string","enum":["exploratory","calibration","confirmatory","holdout","out_of_sample","revalidation"]},"status":{"type":"string","enum":["draft","registered","running","completed","cancelled","archived"]},"createdAt":{"type":"string","format":"date-time"},"registeredAt":{"type":"string","format":"date-time"},"informationCutoff":{"type":"string","format":"date-time"},"purpose":{"type":"string","minLength":4,"maxLength":4000},"population":{"type":"string","minLength":1,"maxLength":2000},"primaryMetric":{"type":"string","minLength":1,"maxLength":500},"benchmarkSpec":{"type":"string","minLength":1,"maxLength":1000},"counterfactualPolicy":{"type":"string","minLength":1,"maxLength":2000},"confounderPolicy":{"type":"string","minLength":1,"maxLength":2000},"executionPolicy":{"type":"string","minLength":1,"maxLength":2000}}}
