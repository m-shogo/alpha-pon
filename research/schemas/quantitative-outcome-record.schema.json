{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/quantitative-outcome-record.schema.json",
  "title": "Alpha Pon Quantitative Outcome Record v1",
  "description": "PIT close-to-close quantitative answer-check record. Semantic invalidation and final human verdict are deliberately excluded from this stage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcomeId",
    "recommendationId",
    "recommendationContentHash",
    "reviewedAt",
    "measurementCutoff",
    "measurementMethod",
    "returnBasis",
    "issuerCorporateActionClearanceHash",
    "baselineTradingDate",
    "terminalTradingDate",
    "issuerBaselineRecordHash",
    "benchmarkBaselineRecordHash",
    "sectorBenchmarkBaselineRecordHash",
    "issuerTerminalRecordHash",
    "benchmarkTerminalRecordHash",
    "sectorBenchmarkTerminalRecordHash",
    "issuerMeasurementRecordHashes",
    "benchmarkMeasurementRecordHashes",
    "sectorBenchmarkMeasurementRecordHashes",
    "maxReturn",
    "maxDrawdown",
    "terminalReturn",
    "benchmarkReturn",
    "sectorBenchmarkReturn",
    "benchmarkExcessReturn",
    "sectorBenchmarkExcessReturn",
    "targetAssessment",
    "reviewStage",
    "invalidationAssessment",
    "verdict",
    "correctAssumptions",
    "incorrectAssumptions",
    "missingEvidence",
    "unexpectedConfounders",
    "lessons",
    "nextRuleChanges",
    "automaticTradingAuthorized",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "outcomeId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "recommendationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "recommendationContentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "measurementCutoff": { "type": "string", "format": "date-time" },
    "measurementMethod": { "const": "pit-close-common-date-v1" },
    "returnBasis": { "const": "unadjusted-close-price-return-corporate-action-cleared-v1" },
    "issuerCorporateActionClearanceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baselineTradingDate": { "type": "string", "format": "date" },
    "terminalTradingDate": { "type": "string", "format": "date" },
    "issuerBaselineRecordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "benchmarkBaselineRecordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sectorBenchmarkBaselineRecordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issuerTerminalRecordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "benchmarkTerminalRecordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sectorBenchmarkTerminalRecordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issuerMeasurementRecordHashes": { "$ref": "#/$defs/hashList" },
    "benchmarkMeasurementRecordHashes": { "$ref": "#/$defs/hashList" },
    "sectorBenchmarkMeasurementRecordHashes": { "$ref": "#/$defs/hashList" },
    "maxReturn": { "type": "number", "minimum": -1 },
    "maxDrawdown": { "type": "number", "minimum": -1, "maximum": 0 },
    "terminalReturn": { "type": "number", "minimum": -1 },
    "benchmarkReturn": { "type": "number", "minimum": -1 },
    "sectorBenchmarkReturn": { "type": "number", "minimum": -1 },
    "benchmarkExcessReturn": { "type": "number" },
    "sectorBenchmarkExcessReturn": { "type": "number" },
    "targetAssessment": { "type": "string", "enum": ["reached", "not_reached", "not_applicable"] },
    "targetReachedAt": { "type": "string", "format": "date" },
    "reviewStage": { "const": "quantitative_measurement" },
    "invalidationAssessment": { "const": "not_assessed" },
    "verdict": { "const": "inconclusive" },
    "correctAssumptions": { "$ref": "#/$defs/textList" },
    "incorrectAssumptions": { "$ref": "#/$defs/textList" },
    "missingEvidence": { "$ref": "#/$defs/textList" },
    "unexpectedConfounders": { "$ref": "#/$defs/textList" },
    "lessons": { "$ref": "#/$defs/textList" },
    "nextRuleChanges": { "$ref": "#/$defs/textList" },
    "supersedesOutcomeId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "automaticTradingAuthorized": { "const": false },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "hashList": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    }
  }
}