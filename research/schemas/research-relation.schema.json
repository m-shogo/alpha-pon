{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/research-relation.schema.json",
  "title": "Research Relation",
  "description": "Canonical semantic relation. Research-owned relation IDs are strict; endpoint IDs are opaque references because external authorities have independent identity contracts. Inverse relations are derived, not duplicated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ontologyVersion",
    "id",
    "relationType",
    "sourceType",
    "sourceId",
    "targetType",
    "targetId",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ontologyVersion": { "const": "research-knowledge-v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 4,
      "maxLength": 128
    },
    "relationType": {
      "type": "string",
      "enum": [
        "observes_event",
        "addresses",
        "member_of",
        "part_of",
        "considers_mechanism",
        "studies",
        "used_in",
        "documents",
        "operationalizes",
        "implements",
        "applies_edge",
        "triggered_by",
        "depends_on"
      ]
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "research_item",
        "research_question",
        "observation",
        "mechanism",
        "research_family",
        "research_component",
        "case",
        "study",
        "study_result",
        "opportunity",
        "edge",
        "event",
        "document",
        "watch",
        "implementation",
        "outcome",
        "claim",
        "evidence"
      ]
    },
    "sourceId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "targetType": {
      "type": "string",
      "enum": [
        "research_item",
        "research_question",
        "observation",
        "mechanism",
        "research_family",
        "research_component",
        "case",
        "study",
        "study_result",
        "opportunity",
        "edge",
        "event",
        "document",
        "watch",
        "implementation",
        "outcome",
        "claim",
        "evidence"
      ]
    },
    "targetId": { "type": "string", "minLength": 1, "maxLength": 512 },
    "role": {
      "type": "string",
      "enum": [
        "seed",
        "supporting_sample",
        "negative_control",
        "near_miss",
        "contradictory",
        "confounded",
        "calibration",
        "holdout",
        "out_of_sample",
        "candidate",
        "primary",
        "secondary",
        "competing",
        "weakened",
        "rejected",
        "design",
        "supporting_note",
        "guard",
        "infrastructure"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "informationCutoff": { "type": "string", "format": "date-time" },
    "notes": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
