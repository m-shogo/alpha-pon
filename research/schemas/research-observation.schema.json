{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"alpha-pon/research/research-observation.schema.json","title":"Research Observation","description":"A noticed phenomenon, distinct from the underlying Event and from a causal conclusion.","type":"object","additionalProperties":false,"required":["schemaVersion","ontologyVersion","id","title","observedAt","origin","summary"],"properties":{"schemaVersion":{"const":1},"ontologyVersion":{"const":"research-knowledge-v1"},"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"title":{"type":"string","minLength":4,"maxLength":200},"observedAt":{"type":"string","format":"date-time"},"origin":{"type":"string","enum":["user","world_scan","company_watch","document_diff","agent_discovery","orphan_detection","outcome_learning","manual_research","external_news_discovery","migration"]},"summary":{"type":"string","minLength":4,"maxLength":4000}}}
