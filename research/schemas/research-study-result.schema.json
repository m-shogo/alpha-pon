{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"alpha-pon/research/research-study-result.schema.json","title":"Research Study Result","description":"Study result metadata, distinct from individual Recommendation Outcome.","type":"object","additionalProperties":false,"required":["schemaVersion","ontologyVersion","id","studyId","sampleManifestId","createdAt","effectSummary","identificationQuality","exploitability","limitations"],"properties":{"schemaVersion":{"const":1},"ontologyVersion":{"const":"research-knowledge-v1"},"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"studyId":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"sampleManifestId":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"createdAt":{"type":"string","format":"date-time"},"effectSummary":{"type":"string","minLength":4,"maxLength":4000},"identificationQuality":{"type":"string","enum":["unidentified","descriptive","correlational","suggestive_causal","strong_causal"]},"exploitability":{"type":"string","enum":["unknown","observed_effect_only","statistical_edge","economic_edge","executable_edge","not_executable"]},"limitations":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":2000}},"negativeFindings":{"type":"array","uniqueItems":true,"items":{"type":"string","enum":["wrong_mechanism","already_priced_in","no_effect","inverse_effect","confounded","not_executable","regime_dependent","data_artifact","false_analogy","selection_bias","insufficient_sample"]}}}}
