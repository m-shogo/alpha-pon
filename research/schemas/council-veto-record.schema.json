{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-pon.local/schemas/council-veto-record.schema.json",
  "title": "Stock Pro Council Veto Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "vetoId",
    "councilRunId",
    "personaId",
    "personaVersion",
    "jurisdiction",
    "vetoCode",
    "scope",
    "issuedAt",
    "informationCutoff",
    "evidenceRefs",
    "clearanceRequirements",
    "status",
    "ruleVersion",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "vetoId": { "type": "string", "minLength": 3 },
    "councilRunId": { "type": "string", "minLength": 3 },
    "personaId": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "personaVersion": { "type": "string", "minLength": 1 },
    "jurisdiction": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9_]+$"
    },
    "vetoCode": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[a-z0-9_]+$"
    },
    "scope": {
      "type": "string",
      "enum": ["data", "recommendation", "execution", "position", "short"]
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "informationCutoff": { "type": "string", "format": "date-time" },
    "evidenceRefs": { "$ref": "#/$defs/nonEmptyStringArray" },
    "clearanceRequirements": { "$ref": "#/$defs/nonEmptyStringArray" },
    "status": {
      "type": "string",
      "enum": ["binding", "cleared", "superseded"]
    },
    "supersedesVetoId": { "type": "string", "minLength": 3 },
    "clearanceMode": {
      "type": "string",
      "enum": ["new_evidence", "versioned_rule_correction"]
    },
    "clearedAt": { "type": "string", "format": "date-time" },
    "clearanceEvidenceRefs": { "$ref": "#/$defs/stringArray" },
    "ruleVersion": { "type": "string", "minLength": 1 },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
