{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"alpha-pon/research/research-question.schema.json","title":"Research Question","description":"Concrete research question; ownership is expressed by ResearchRelation.","type":"object","additionalProperties":false,"required":["schemaVersion","ontologyVersion","id","question","status","createdAt"],"properties":{"schemaVersion":{"const":1},"ontologyVersion":{"const":"research-knowledge-v1"},"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"question":{"type":"string","minLength":8,"maxLength":1000},"status":{"type":"string","enum":["open","partially_answered","answered","blocked","obsolete"]},"createdAt":{"type":"string","format":"date-time"},"lastReviewedAt":{"type":"string","format":"date-time"}}}
