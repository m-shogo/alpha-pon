{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/research-asset-provenance.schema.json",
  "title": "Research Asset Provenance",
  "description": "Exact canonical-main first-known provenance for a stable Research Asset ID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetId",
    "firstKnownAt",
    "basis",
    "sourceCommitSha",
    "sourceCommitAt",
    "sourcePath"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 4,
      "maxLength": 128
    },
    "firstKnownAt": { "type": "string", "format": "date-time" },
    "basis": { "const": "canonical_git_first_presence" },
    "sourceCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceCommitAt": { "type": "string", "format": "date-time" },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
