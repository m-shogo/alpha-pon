{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/price-record.schema.json",
  "title": "Research OS PIT Price Record",
  "description": "銘柄・指数の日足を、その時点で利用可能だった情報だけで再現するappend-only record。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seriesKind",
    "code",
    "market",
    "tradingDate",
    "dataAsOf",
    "observedAt",
    "retrievedAt",
    "firstExecutableAt",
    "source",
    "sourceVersion",
    "providerPlan",
    "delayDays",
    "isDelayed",
    "ingestionRunId",
    "currency",
    "status",
    "adjusted",
    "adjustmentFactor",
    "corporateActions",
    "license",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "seriesKind": { "type": "string", "enum": ["security", "benchmark"] },
    "code": { "type": "string", "minLength": 1, "maxLength": 64 },
    "market": { "type": "string", "minLength": 1, "maxLength": 64 },
    "tradingDate": { "type": "string", "format": "date" },
    "dataAsOf": {
      "type": "string",
      "format": "date-time",
      "description": "価格・出来高が表す市場時点。通常は取引日の引け時刻。"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "description": "このデータが契約上利用可能になった時刻。PITの正本。"
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Alpha Ponがproviderから実際に取得した時刻。"
    },
    "firstExecutableAt": {
      "type": "string",
      "format": "date-time",
      "description": "このrecordを利用した注文が最初に約定可能となる時刻。"
    },
    "source": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "providerPlan": {
      "type": "string",
      "enum": ["free", "standard", "premium", "official_public", "synthetic", "unknown"]
    },
    "delayDays": { "type": "integer", "minimum": 0, "maximum": 3660 },
    "isDelayed": { "type": "boolean" },
    "ingestionRunId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "currency": { "type": "string", "minLength": 3, "maxLength": 8 },
    "status": { "type": "string", "enum": ["traded", "suspended", "no_trade", "missing"] },
    "missingReason": {
      "type": "string",
      "enum": [
        "exchange_suspension",
        "market_holiday",
        "no_execution",
        "provider_gap",
        "outside_entitlement",
        "not_yet_available",
        "unknown"
      ]
    },
    "ohlcv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open", "high", "low", "close", "volume"],
      "properties": {
        "open": { "type": "number", "exclusiveMinimum": 0 },
        "high": { "type": "number", "exclusiveMinimum": 0 },
        "low": { "type": "number", "exclusiveMinimum": 0 },
        "close": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "integer", "minimum": 0 }
      }
    },
    "adjusted": { "type": "boolean" },
    "adjustmentFactor": { "type": "number", "exclusiveMinimum": 0 },
    "corporateActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "effectiveDate", "observedAt", "source"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["split", "reverse_split", "dividend", "rights", "merger", "spinoff", "other"]
          },
          "effectiveDate": { "type": "string", "format": "date" },
          "factor": { "type": "number", "exclusiveMinimum": 0 },
          "observedAt": { "type": "string", "format": "date-time" },
          "source": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "benchmarkCode": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sectorBenchmarkCode": { "type": "string", "minLength": 1, "maxLength": 64 },
    "license": {
      "type": "string",
      "enum": ["redistributable", "metadata_only", "local_only", "unknown"]
    },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "supersedesHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
