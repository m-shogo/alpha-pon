{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/edge-family.schema.json",
  "title": "EdgeFamilyCatalog",
  "description": "個別銘柄や単発テーマではなく、技術・供給網・規制の因果構造をEdge候補として保存する契約。catalog登録はProduction Gate通過を意味しない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "families"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "families": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "activationState",
        "priority",
        "thesis",
        "mechanismSteps",
        "beneficiaryLayers",
        "leadingEvidence",
        "confirmationEvidence",
        "requiredDataRoles",
        "confounders",
        "falsificationRules",
        "expectedLag",
        "examples",
        "excludedShortcuts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "minLength": 6,
          "maxLength": 80
        },
        "title": { "type": "string", "minLength": 3 },
        "activationState": {
          "type": "string",
          "enum": ["catalog", "candidate", "active-research", "shadow", "validated", "rejected", "dormant"]
        },
        "priority": { "type": "string", "enum": ["A", "B", "C"] },
        "thesis": { "type": "string", "minLength": 20 },
        "mechanismSteps": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 2 }
        },
        "beneficiaryLayers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "final-product",
              "platform",
              "tier-1",
              "tier-2",
              "tier-3",
              "material",
              "equipment",
              "inspection",
              "infrastructure",
              "integration",
              "maintenance",
              "service"
            ]
          }
        },
        "leadingEvidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "confirmationEvidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "requiredDataRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "research",
              "patent",
              "grant",
              "standard",
              "certification",
              "company_ir",
              "filing",
              "procurement",
              "capacity",
              "inspection",
              "supplier_mapping",
              "market_data",
              "benchmark",
              "demand_proxy",
              "regulation",
              "execution"
            ]
          }
        },
        "confounders": { "type": "array", "items": { "type": "string" } },
        "falsificationRules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "expectedLag": { "type": "string", "minLength": 2 },
        "activationGate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "objectiveTriggerDefined": { "type": "boolean" },
            "entityMappingAvailable": { "type": "boolean" },
            "pitTimestampsAvailable": { "type": "boolean" },
            "executablePriceRouteAvailable": { "type": "boolean" },
            "samplePathAvailable": { "type": "boolean" },
            "dataRightsReviewed": { "type": "boolean" },
            "falsificationDefined": { "type": "boolean" }
          }
        },
        "examples": { "type": "array", "items": { "type": "string" } },
        "excludedShortcuts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    }
  }
}
