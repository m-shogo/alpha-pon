{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"alpha-pon/research/research-item.schema.json","title":"Research Item","description":"Early-to-resolved research identity. Does not require formal Edge fields.","type":"object","additionalProperties":false,"required":["schemaVersion","ontologyVersion","id","title","status","createdAt","origin","summary"],"properties":{"schemaVersion":{"const":1},"ontologyVersion":{"const":"research-knowledge-v1"},"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(-[a-z0-9]+)*$","minLength":4,"maxLength":128},"title":{"type":"string","minLength":4,"maxLength":200},"aliases":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},"status":{"type":"string","enum":["captured","triage","investigating","synthesized","resolved","parked","archived"]},"createdAt":{"type":"string","format":"date-time"},"origin":{"type":"string","enum":["user","world_scan","company_watch","document_diff","agent_discovery","orphan_detection","outcome_learning","manual_research","external_news_discovery","migration"]},"summary":{"type":"string","minLength":4,"maxLength":4000},"resolution":{"type":"string","enum":["existing_edge","component_candidate","new_edge_candidate","case_only","theme_context","infrastructure","not_repeatable","invalid_premise","insufficient_evidence","duplicate"]},"stopReason":{"type":"string","enum":["resolved","duplicate","no_mechanism","insufficient_sample","data_unavailable","not_executable","false_premise","superseded","low_voi","parked"]},"lastReviewedAt":{"type":"string","format":"date-time"}}}
