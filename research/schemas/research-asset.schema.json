{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alpha-pon/research/research-asset.schema.json",
  "title": "Research Asset",
  "description": "Stable identity for a repository document, watch configuration, or implementation module referenced by Research Knowledge.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "assetType", "path", "status", "description"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "minLength": 4,
      "maxLength": 128
    },
    "assetType": {
      "type": "string",
      "enum": ["document", "watch", "implementation"]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated"]
    },
    "description": {
      "type": "string",
      "minLength": 4,
      "maxLength": 2000
    }
  }
}
