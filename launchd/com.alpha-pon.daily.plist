<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alpha-pon.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/m-shogo/Developer/personal/alpha-pon/node_modules/.bin/tsx</string>
    <string>/Users/m-shogo/Developer/personal/alpha-pon/src/daily.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/m-shogo/Developer/personal/alpha-pon</string>

  <!-- 毎朝7:30に実行 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/m-shogo/Developer/personal/alpha-pon/logs/daily.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/m-shogo/Developer/personal/alpha-pon/logs/daily-error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- .envは自動読み込みされないため必要な変数をここに記載 -->
    <!-- JQUANTS_EMAIL / JQUANTS_PASSWORD / SLACK_WEBHOOK_URL は手動で設定 -->
    <key>PATH</key>
    <string>/Users/m-shogo/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- macがスリープ中だった場合は起動後に実行 -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
