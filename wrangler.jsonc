{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alpha-pon",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./apps/web/out",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/market-events*",
      "/api/calendar-feed-url*",
      "/calendar.ics*",
      "/healthz*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha-pon-market-events",
      "database_id": "7b90faf4-9834-4393-a921-275e0a68b398"
    }
  ]

  // Runtime values stay in Cloudflare Variables and Secrets rather than Git.
  // Required later:
  // - OWNER_EMAIL
  // - PUBLIC_ORIGIN
  // - secret CALENDAR_FEED_TOKEN
}
