# J-Quants Free プラン（日本株の株価・財務データ取得）
# 未設定の場合、J-Quantsを必要とする機能はfail-closed/モック等の既存挙動に従う
JQUANTS_API_KEY=
JQUANTS_V2_DATA_DELAY_DAYS=84
JQUANTS_V2_REQUEST_INTERVAL_MS=3000
JQUANTS_V2_RETRY_ATTEMPTS=5
ANALOGY_REVIEW_MAX_PER_RUN=12
UNIVERSE_SCAN_MAX_PER_RUN=8
# V1 互換用。通常は JQUANTS_API_KEY を使う。
JQUANTS_EMAIL=
JQUANTS_PASSWORD=

# 企業固有ショック: JP benchmark
MARKET_BENCHMARK_CODE=1306

# 企業固有ショック: US株価（Twelve Data / 任意）
# 未設定ならUSの価格ゲートはunknownとなりLINE通知しない
TWELVE_DATA_API_KEY=
TWELVE_DATA_REQUEST_TIMEOUT_MS=15000
TWELVE_DATA_REQUEST_INTERVAL_MS=8000
TWELVE_DATA_RETRY_ATTEMPTS=3
# S&P 500の市場proxy。既定はSPY
US_MARKET_BENCHMARK_SYMBOL=SPY

# 企業固有ショック: SEC EDGAR一次情報（US / 任意）
# SEC fair-access policyに従い、実際に連絡可能な識別情報をUser-Agentへ設定する
SEC_USER_AGENT=
SEC_REQUEST_TIMEOUT_MS=15000
SEC_REQUEST_INTERVAL_MS=250
SHOCK_SEC_SYMBOLS=
SHOCK_SEC_LOOKBACK_DAYS=120

# 手動価格overrideの有効期間
SHOCK_PRICE_OVERRIDE_MAX_AGE_DAYS=3

# LINE Messaging API
# セットアップ: pnpm setup:line
# 1. https://developers.line.biz/ でMessaging APIチャネル作成
# 2. チャネルアクセストークン（長期）を発行
# 3. ボットを友達追加 → pnpm setup:line でUser ID取得
LINE_CHANNEL_TOKEN=
LINE_USER_ID=

# Slack通知（任意 / チームで使う場合）
SLACK_WEBHOOK_URL=

# モードフラグ
USE_MOCK=false
