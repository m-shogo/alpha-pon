# J-Quants Free プラン（株価・財務データ取得）
# 未設定の場合はモックデータで動作
JQUANTS_API_KEY=
# V1 互換用。通常は JQUANTS_API_KEY を使う。
JQUANTS_EMAIL=
JQUANTS_PASSWORD=

# LINE Messaging API
# セットアップ: pnpm setup:line
# 1. https://developers.line.biz/ でMessaging APIチャネル作成
# 2. チャネルアクセストークン（長期）を発行
# 3. ボットを友達追加 → pnpm setup:line でUser ID取得
LINE_CHANNEL_TOKEN=
LINE_USER_ID=

# Slack通知（任意 / チームで使う場合）
SLACK_WEBHOOK_URL=

# モードフラグ
USE_MOCK=false
