{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alpha-pon",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./apps/web/out",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/market-events*",
      "/api/calendar-feed-url*",
      "/calendar.ics*",
      "/healthz*"
    ]
  },
  "vars": {
    "OWNER_EMAIL": "YOUR_CLOUDFLARE_ACCESS_EMAIL",
    "PUBLIC_ORIGIN": "https://YOUR_ALPHA_PON_WORKERS_DEV_OR_CUSTOM_DOMAIN"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alpha-pon-market-events",
      "database_id": "REPLACE_AFTER_D1_CREATION",
      "preview_database_id": "REPLACE_AFTER_D1_CREATION"
    }
  ]
}
